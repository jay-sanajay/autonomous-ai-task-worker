{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "functions": {
    "api/**/*.py": {
      "includeFiles": [
        "frontend/dist/**",
        "backend/**",
        "sandbox_data/**",
        "simulated_company/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
