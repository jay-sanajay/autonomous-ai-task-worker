# CentraWorker Environment Configuration

# LLM Provider selection: "auto", "mock", "openai", or "gemini"
# "auto" uses OpenAI or Gemini if keys are present, else defaults to the intelligent SmartMockProvider
LLM_PROVIDER=auto

# Optional API Keys (Leave blank to use the deterministic offline engine out-of-the-box)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Enterprise Policy Thresholds
HIGH_RISK_FINANCIAL_THRESHOLD=10000.0
MAX_AGENT_STEPS=15
